@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
	ViewData["Title"] = "Listado de tareas";
}

<div class="text-center">
	<h1 class="display-4">@Localizer["My Tasks"]</h1>
</div>

<div id="task-list-container" class="text-center">
	<div class="text-start" data-bind="foreach: userTasks">
		<div name="task" class="border mb-2 p-2" style="cursor: pointer">
			<div data-bind="text: title" class="fw-bold">

			</div>
		</div>
	</div>
	<div data-bind="visible: loading" class="spinner-border">
		<span class="visually-hidden">Cargando...</span>
	</div>
</div>

@section Scripts{
	<script>
		const taskListViewModel = {
			userTasks : ko.observableArray([]),
			loading: ko.observable(true)
		}

		setTimeout(
		() => {
			taskListViewModel.userTasks.push({title: 'Tarea 1'});
			taskListViewModel.loading(false);
		}
		, 2000);

		ko.applyBindings(taskListViewModel, document.getElementById('task-list-container'));
	</script>
}