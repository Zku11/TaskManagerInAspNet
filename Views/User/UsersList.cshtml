@model UsersListViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer localizer

@{
	ViewData["Title"] = "Listado de usuarios";
	Layout = "../shared/_layout";
}

<h1 class="fs-4">@localizer["users.list.title"]</h1>

@if (Model.Message is not null)
{
	<div class="alert alert-success" role="alert">
		@Model.Message
	</div>
}

@if(Model.Users is not null)
{
	<form method="post">
		<table class="table table-hover">
			<thead>
				<tr>
					<td>@localizer["action"]</td>
					<td>@localizer["email"]</td>
				</tr>
			</thead>
			<tbody>
				@foreach (var user in Model.Users)
				{
					<tr>
						<td>
							<button class="btn btn-primary me-2" asp-action="MakeAdministrator" asp-route-email="@user.Email">
								@localizer["make.admin.button"]
							</button>
							<button class="btn btn-secondary me-2" asp-action="RemoveAdministrator" asp-route-email="@user.Email">
								@localizer["remove.admin.button"]
							</button>
						</td>
						<td>
							@user.Email
						</td>
					</tr>
				}
			</tbody>
		</table>
	</form>
}
else
{
	<p>No hay usuarios para mostrar.</p>
}